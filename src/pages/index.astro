---
import { readFileSync } from 'fs';
import Base from '../layouts/Base.astro';
import { CANONICAL_BOOK_CATALOG } from '../data/catalog.js';

const editions = JSON.parse(readFileSync('edicoes/index.json', 'utf-8'));

const title = 'Bíblia Pe. Figueiredo — Tradução da Vulgata Clementina em Português';
const description = 'Leia a Bíblia Sagrada na tradução do Pe. Antônio Pereira de Figueiredo (1750-1816), a primeira e mais fiel tradução da Vulgata Clementina para o português, com texto integral de todos os livros canônicos.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  'name': 'Bíblia Traduzida',
  'url': 'https://bibliatraduzida.com',
  'description': description,
  'inLanguage': 'pt-BR',
  'publisher': {
    '@type': 'Organization',
    'name': 'Bíblia Traduzida',
    'url': 'https://bibliatraduzida.com',
    'logo': {
      '@type': 'ImageObject',
      'url': 'https://bibliatraduzida.com/icons/icon-512.png',
    },
  },
};

const booksByTestament = new Map();
for (const book of CANONICAL_BOOK_CATALOG) {
  const t = book.testamento;
  const g = book.grupo;
  if (!booksByTestament.has(t)) booksByTestament.set(t, new Map());
  const groups = booksByTestament.get(t);
  if (!groups.has(g)) groups.set(g, []);
  groups.get(g).push(book);
}

// Mapas para o "Continuar lendo" (usados no script client-side)
const bookTitleMap = Object.fromEntries(CANONICAL_BOOK_CATALOG.map(b => [b.id, b.tituloIndice]));
const editionNameMap = Object.fromEntries(editions.map(e => [e.id, e.edicao]));
const homeDataJson = JSON.stringify({ bookTitleMap, editionNameMap });
---
<Base {title} {description} canonical="https://bibliatraduzida.com/" {jsonLd}>
<div id="home-page">
  <header class="home-header">
    <h1>Bíblia Traduzida</h1>
    <p class="home-subtitle">por Padre Antônio Pereira de Figueiredo</p>
    <p class="home-about">
      A revisão da transcrição da edição Pe. Figueiredo (1950) ainda está sendo feita. Se quiser reportar qualquer problema, envie um e-mail para <a href="mailto:gmoraizsilva@gmail.com">gmoraizsilva@gmail.com</a>.
    </p>
  </header>

  <main class="home-main">
    <!-- "Continuar lendo" — populado pelo script abaixo via localStorage -->
    <div id="continue-reading" hidden>
      <section class="home-continue">
        <h2>Continuar lendo</h2>
        <div id="continue-cards" class="continue-cards"></div>
      </section>
    </div>

    <section class="home-books">
      {Array.from(booksByTestament.entries()).map(([testamento, groups]) => (
        <div class="home-testament">
          <h2>{testamento}</h2>
          {Array.from(groups.entries()).map(([grupo, books]) => (
            <div class="home-group">
              <h3>{grupo}</h3>
              <ul class="home-book-list">
                {books.map(book => (
                  <li>
                    <a href={`/figueiredo/${book.id}/1/`}>{book.tituloIndice}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      ))}
    </section>

    <section class="home-editions">
      <h2>Edições disponíveis</h2>
      <div class="edition-cards">
        {editions.map(ed => (
          <a href={`/${ed.id}/genesis/1/`} class="edition-card">
            <strong>{ed.edicao}</strong>
            <span>{ed.idioma === 'pt-BR' ? 'Português' : ed.idioma === 'la' ? 'Latim' : 'English'}</span>
          </a>
        ))}
      </div>
    </section>
  </main>
</div>

<style>
  #home-page {
    max-width: 1000px;
    margin: 0 auto;
    padding: 16px 0 32px;
    font-family: 'David Libre', Georgia, 'Times New Roman', serif;
  }
  .home-header { text-align: center; padding: 12px 16px 14px; border-bottom: 1px solid #d9cebd; margin-bottom: 20px; }
  .home-header h1 { margin-top: 0; font-size: 1.8rem; color: #2a1f0e; line-height: 1.2; }
  .home-subtitle { color: #666; font-size: 1rem; margin-top: 4px; }
  .home-about { font-size: 12px; color: #888; margin-top: 8px; line-height: 1.5; }
  .home-about a { color: #2f4f9d; }

  /* Edições disponíveis */
  .home-editions { padding: 0 16px; margin-bottom: 28px; }
  .home-editions h2 { font-size: 1.1rem; margin-bottom: 10px; color: #2a1f0e; }
  .edition-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .edition-card {
    display: flex; flex-direction: column; padding: 10px 16px;
    background: #fff; border: 1px solid #d9cebd; border-radius: 6px;
    text-decoration: none; color: #333; font-size: 14px; gap: 3px;
  }
  .edition-card:last-child:nth-child(odd) { grid-column: 1 / -1; }
  .edition-card strong { font-size: 14px; color: #2a1f0e; }
  .edition-card span { font-size: 12px; color: #888; }
  .edition-card:hover { border-color: #8b6914; background: #faf7f0; }

  /* Lista de livros */
  .home-books { display: grid; grid-template-columns: 1fr; gap: 0; margin-bottom: 0; padding: 0 16px 20px; }
  .home-testament { margin-bottom: 20px; }
  .home-testament:last-child { margin-bottom: 0; }
  .home-testament > h2 { font-size: 1.05rem; border-bottom: 1px solid #d9cebd; padding-bottom: 5px; margin-bottom: 12px; color: #2a1f0e; }
  .home-group { margin-bottom: 12px; }
  .home-group:last-child { margin-bottom: 0; }
  .home-group h3 { font-size: .8rem; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; color: #7a6652; margin-bottom: 4px; }
  .home-book-list { display: flex; flex-wrap: wrap; gap: 4px 10px; list-style: none; padding: 0; }
  .home-book-list a { color: #2f4f9d; font-size: 14px; padding: 2px 0; display: inline-block; }
  .home-book-list a:hover { text-decoration: underline; }

  /* Continuar lendo — full-width, sem padding lateral no container */
  .home-continue { margin-bottom: 0; padding-bottom: 16px; }
  .home-continue h2 { font-size: 1.05rem; margin-bottom: 8px; color: #2a1f0e; padding-left: 16px; }

  /* Último testamento sem margem extra — movido para dentro da regra acima */

  @media (min-width: 640px) {
    #home-page { padding: 24px 16px 40px; }
    .home-header { padding: 12px 0 14px; }
    .home-editions { padding: 0; }
    .home-books { padding: 0; }
    .home-header h1 { font-size: 2.2rem; }
    .home-subtitle { font-size: 1.1rem; }
    .home-about { font-size: 13px; }
    .home-books { grid-template-columns: 1fr 1fr; gap: 0 32px; margin-bottom: 28px; }
    .home-testament { margin-bottom: 0; }
    .home-continue { padding-bottom: 20px; }
    .home-continue h2 { padding-left: 0; }
    .edition-cards { grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); }
    .edition-card:last-child:nth-child(odd) { grid-column: auto; }
  }
</style>

<style is:global>
  /* Classes aplicadas dinamicamente via JS — precisam ser globais */
  .continue-cards {
    display: flex; gap: 10px;
    overflow-x: auto; flex-wrap: nowrap;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
    scroll-padding-left: 16px;
    padding-bottom: 6px;
    scrollbar-width: none;
  }
  .continue-cards::-webkit-scrollbar { display: none; }
  .continue-card {
    display: flex; align-items: center; gap: 10px;
    padding: 8px 12px;
    background: #fff8ec; border: 1px solid #c9a84c; border-radius: 6px;
    text-decoration: none; color: #2a1f0e;
    transition: background .15s, border-color .15s;
    scroll-snap-align: start; flex-shrink: 0;
  }
  .continue-card:hover { background: #fff3d6; border-color: #8b6914; }
  .continue-card::before { content: "📖"; font-size: 1.3rem; flex-shrink: 0; }
  .continue-card-text { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
  .continue-book { font-weight: bold; font-size: .95rem; }
  .continue-chapter { font-size: .95rem; font-weight: normal; color: #555; }
  .continue-edition { font-size: .75rem; color: #888; }
  /* Espaçador inicial — mais confiável que padding-left em overflow containers */
  .continue-cards::before { content: ''; min-width: 16px; flex-shrink: 0; }
  .continue-card:last-child { margin-right: 16px; }
  @media (min-width: 640px) {
    .continue-cards { flex-wrap: wrap; overflow-x: visible; }
    .continue-cards::before { display: none; }
    .continue-card:last-child { margin-right: 0; }
  }

  /* ── Home: modo noturno ─────────────────────────────────────── */
  /* Usar #home-page para ganhar especificidade sobre os estilos escopados */
  body.dark-mode #home-page .home-header {
    border-bottom-color: #4d4338;
  }
  body.dark-mode #home-page .home-header h1 {
    color: #f3e8d5;
  }
  body.dark-mode #home-page .home-subtitle {
    color: #b4a899;
  }
  body.dark-mode #home-page .home-about {
    color: #7a7065;
  }
  body.dark-mode #home-page .home-about a {
    color: #8fb9ff;
  }
  body.dark-mode #home-page .home-testament > h2 {
    color: #f3e8d5;
    border-bottom-color: #4d4338;
  }
  body.dark-mode #home-page .home-group h3 {
    color: #9e8c79;
  }
  body.dark-mode #home-page .home-book-list a {
    color: #8fb9ff;
  }
  body.dark-mode #home-page .home-book-list a:hover {
    color: #bdd4ff;
  }
  body.dark-mode #home-page .home-editions h2,
  body.dark-mode #home-page .home-continue h2 {
    color: #f3e8d5;
  }
  body.dark-mode #home-page .edition-card {
    background: #1d1814;
    border-color: #4d4338;
    color: #eee6d6;
  }
  body.dark-mode #home-page .edition-card strong {
    color: #f3e8d5;
  }
  body.dark-mode #home-page .edition-card span {
    color: #b4a899;
  }
  body.dark-mode #home-page .edition-card:hover {
    background: #2a231d;
    border-color: #8b6914;
  }
  body.dark-mode .continue-card {
    background: #1f1a14;
    border-color: #5c4a24;
    color: #eee6d6;
  }
  body.dark-mode .continue-card:hover {
    background: #2a231d;
    border-color: #8b6914;
  }
  body.dark-mode .continue-chapter {
    color: #b4a899;
  }
  body.dark-mode .continue-edition {
    color: #7a7065;
  }
</style>

<script id="home-data" type="application/json" set:html={homeDataJson}></script>
<script is:inline>
  (function () {
    try {
      const raw = localStorage.getItem('biblia:last-navigation');
      if (!raw) return;
      const parsed = JSON.parse(raw);
      // suporta formato antigo (objeto único) e novo (array)
      const entries = Array.isArray(parsed) ? parsed : [parsed];
      const valid = entries.filter(n => n.editionId && n.bookId && n.chapter);
      if (!valid.length) return;

      const homeData = JSON.parse(document.getElementById('home-data').textContent);
      const container = document.getElementById('continue-cards');

      valid.forEach(nav => {
        const bookTitle = homeData.bookTitleMap[nav.bookId] || nav.bookId;
        const editionName = homeData.editionNameMap[nav.editionId] || nav.editionId;
        const link = `/${nav.editionId}/${nav.bookId}/${nav.chapter}/`;
        const a = document.createElement('a');
        a.href = link;
        a.className = 'continue-card';
        a.innerHTML = `<span class="continue-card-text">
          <span><span class="continue-book">${bookTitle}</span> <span class="continue-chapter">Cap. ${nav.chapter}</span></span>
          <span class="continue-edition">${editionName}</span>
        </span>`;
        container.appendChild(a);
      });

      document.getElementById('continue-reading').removeAttribute('hidden');
    } catch (_) {}
  })();
</script>
</Base>
