---
import { readFileSync } from 'fs';
import Base from '../../../layouts/Base.astro';

export async function getStaticPaths() {
  const editions = JSON.parse(readFileSync('edicoes/index.json', 'utf-8'));
  const paths = [];

  for (const edition of editions) {
    if (!edition.livros?.length) continue;
    for (const bookFile of edition.livros) {
      let bookIndex;
      try {
        bookIndex = JSON.parse(readFileSync(bookFile, 'utf-8'));
      } catch (e) {
        continue;
      }
      paths.push({
        params: { edicao: edition.id, livro: bookIndex.id },
        props: { bookIndex, edition: { id: edition.id, edicao: edition.edicao, idioma: edition.idioma || 'pt-BR' } },
      });
    }
  }
  return paths;
}

const { bookIndex, edition } = Astro.props;
const { edicao, livro } = Astro.params;

const title = `${bookIndex.titulo} — ${edition.edicao} | Bíblia Traduzida`;
const description = `Capítulos de ${bookIndex.titulo} na tradução ${edition.edicao}. Bíblia Traduzida.`;
const canonical = `https://bibliatraduzida.com/${edicao}/${livro}/`;
---
<Base {title} {description} {canonical} lang={edition.idioma}>
<div style="max-width:900px;margin:0 auto;padding:24px 16px;">
  <nav style="font-size:14px;margin-bottom:16px;">
    <a href="/">Início</a> &rsaquo;
    <a href={`/${edicao}/genesis/1/`}>{edition.edicao}</a> &rsaquo;
    <span>{bookIndex.titulo}</span>
  </nav>
  <h1 style="font-family:'David Libre',Georgia,serif;font-size:1.8rem;margin-bottom:8px;">{bookIndex.titulo}</h1>
  <p style="color:#666;margin-bottom:24px;">{edition.edicao}</p>
  {bookIndex.introducao && (
    <details style="margin-bottom:24px;">
      <summary style="cursor:pointer;font-weight:bold;">Introdução</summary>
      <div style="margin-top:12px;line-height:1.7;"><Fragment set:html={bookIndex.introducao} /></div>
    </details>
  )}
  <h2 style="font-size:1.1rem;margin-bottom:12px;">Capítulos</h2>
  <div style="display:flex;flex-wrap:wrap;gap:8px;">
    {bookIndex.capitulos.map(n => (
      <a href={`/${edicao}/${livro}/${n}/`} style="display:inline-block;padding:6px 12px;background:#f7f2e8;border:1px solid #d9cebd;border-radius:4px;text-decoration:none;color:#333;font-size:15px;">{n}</a>
    ))}
  </div>
  <div style="margin-top:32px;font-size:14px;">
    <a href={`/${edicao}/${livro}/1/`}>Ler do capítulo 1 →</a>
  </div>
</div>
</Base>
